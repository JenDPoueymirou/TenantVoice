import {
  type Building,
  type InsertBuilding,
  type Issue,
  type InsertIssue,
  buildings,
  issues,
  users,
  type User,
  type InsertUser,
  type IssueCategory
} from "@shared/schema";
import { computeEmbedding } from "./vector";
import { db } from "./db";
import { eq, sql, desc, count, and, ne, like } from "drizzle-orm";

export interface IStorage {
  // User operations (preserved from original)
  getUser(id: number): Promise<User | undefined>;
  getUserByUsername(username: string): Promise<User | undefined>;
  createUser(user: InsertUser): Promise<User>;
  
  // Building operations
  getBuildings(): Promise<Building[]>;
  getBuilding(id: number): Promise<Building | undefined>;
  getBuildingsByLandlord(landlord: string): Promise<Building[]>;
  createBuilding(building: InsertBuilding): Promise<Building>;
  
  // Issue operations
  getIssues(): Promise<Issue[]>;
  getIssue(id: number): Promise<Issue | undefined>;
  getIssuesByBuilding(buildingId: number): Promise<Issue[]>;
  getIssuesByCategory(category: IssueCategory): Promise<Issue[]>;
  createIssue(issue: InsertIssue): Promise<Issue>;
  updateIssueStatus(id: number, status: string): Promise<Issue | undefined>;
  
  // Stats operations
  getIssueStats(): Promise<{
    totalIssues: number;
    buildingsAffected: number;
    unresolvedIssues: number;
    resolvedIssues: number;
  }>;
  getIssuesByCategories(): Promise<Record<IssueCategory, number>>;
  getTopBuildingsByIssues(limit: number): Promise<
    Array<{
      building: Building;
      issueCount: number;
      status: string;
      trend: number;
    }>
  >;

  // Thematic clustering operations
  getIssueClusters(
    addressFilter?: string,
    categoryFilter?: IssueCategory,
    clusterCount?: number
  ): Promise<Array<{
    id: string;
    name: string;
    description: string;
    size: number;
    issues: Issue[];
  }>>;
  
  // Vector search operations
  searchIssues(query: string, limit?: number): Promise<Issue[]>;
  searchBuildingsByAddress(query: string, limit?: number): Promise<Building[]>;
  searchIssuesByLocation(query: string, limit?: number): Promise<Issue[]>;
}

export class DatabaseStorage implements IStorage {
  // User operations
  async getUser(id: number): Promise<User | undefined> {
    const [user] = await db.select().from(users).where(eq(users.id, id));
    return user;
  }

  async getUserByUsername(username: string): Promise<User | undefined> {
    const [user] = await db.select().from(users).where(eq(users.username, username));
    return user;
  }

  async createUser(insertUser: InsertUser): Promise<User> {
    const [user] = await db.insert(users).values(insertUser).returning();
    return user;
  }
  
  // Building operations
  async getBuildings(): Promise<Building[]> {
    return await db.select().from(buildings);
  }
  
  async getBuilding(id: number): Promise<Building | undefined> {
    const [building] = await db.select().from(buildings).where(eq(buildings.id, id));
    return building;
  }
  
  async getBuildingsByLandlord(landlord: string): Promise<Building[]> {
    return await db.select().from(buildings)
      .where(like(buildings.landlord, `%${landlord}%`));
  }
  
  async createBuilding(building: InsertBuilding): Promise<Building> {
    // Generate vector embedding for building location information
    const addressText = `${building.address} ${building.unit || ''} ${building.city} ${building.state} ${building.zipCode} ${building.landlord}`;
    const vector = await computeEmbedding(addressText);
    
    const [newBuilding] = await db.insert(buildings).values({
      ...building,
      vector
    }).returning();
    
    return newBuilding;
  }
  
  // Issue operations
  async getIssues(): Promise<Issue[]> {
    return await db.select().from(issues);
  }
  
  async getIssue(id: number): Promise<Issue | undefined> {
    const [issue] = await db.select().from(issues).where(eq(issues.id, id));
    return issue;
  }
  
  async getIssuesByBuilding(buildingId: number): Promise<Issue[]> {
    return await db.select().from(issues).where(eq(issues.buildingId, buildingId));
  }
  
  async getIssuesByCategory(category: IssueCategory): Promise<Issue[]> {
    return await db.select().from(issues).where(eq(issues.category, category));
  }
  
  async createIssue(issueData: InsertIssue): Promise<Issue> {
    // Get building information to enrich the vector with location context
    const buildingInfo = await this.getBuilding(issueData.buildingId);
    
    // Generate vector embedding from building info + description + category + subIssues
    let textForEmbedding = `${issueData.category} ${issueData.subIssues.join(' ')} ${issueData.description}`;
    
    // Add building information if available
    if (buildingInfo) {
      textForEmbedding += ` ${buildingInfo.address} ${buildingInfo.unit || ''} ${buildingInfo.city} ${buildingInfo.state} ${buildingInfo.zipCode} ${buildingInfo.landlord}`;
    }
    
    const vector = await computeEmbedding(textForEmbedding);
    
    const [issue] = await db.insert(issues).values({
      ...issueData,
      vector
    }).returning();
    
    return issue;
  }
  
  async updateIssueStatus(id: number, status: string): Promise<Issue | undefined> {
    const [updatedIssue] = await db.update(issues)
      .set({ status })
      .where(eq(issues.id, id))
      .returning();
    
    return updatedIssue;
  }
  
  // Stats operations
  async getIssueStats(): Promise<{
    totalIssues: number;
    buildingsAffected: number;
    unresolvedIssues: number;
    resolvedIssues: number;
  }> {
    // Get total issues
    const [totalResult] = await db.select({ count: count() }).from(issues);
    const totalIssues = totalResult.count;
    
    // Get distinct building count
    const [buildingsResult] = await db.select({ 
      count: count(sql`DISTINCT ${issues.buildingId}`) 
    }).from(issues);
    const buildingsAffected = buildingsResult.count;
    
    // Get unresolved issues
    const [unresolvedResult] = await db.select({ count: count() })
      .from(issues)
      .where(ne(issues.status, 'resolved'));
    const unresolvedIssues = unresolvedResult.count;
    
    // Get resolved issues
    const [resolvedResult] = await db.select({ count: count() })
      .from(issues)
      .where(eq(issues.status, 'resolved'));
    const resolvedIssues = resolvedResult.count;
    
    return {
      totalIssues,
      buildingsAffected,
      unresolvedIssues,
      resolvedIssues
    };
  }
  
  async getIssuesByCategories(): Promise<Record<IssueCategory, number>> {
    const categoryCounts = await db.select({
      category: issues.category,
      count: count()
    })
    .from(issues)
    .groupBy(issues.category);
    
    const result: Partial<Record<IssueCategory, number>> = {};
    
    categoryCounts.forEach(item => {
      result[item.category as IssueCategory] = item.count;
    });
    
    return result as Record<IssueCategory, number>;
  }
  
  async getTopBuildingsByIssues(limit: number): Promise<
    Array<{
      building: Building;
      issueCount: number;
      status: string;
      trend: number;
    }>
  > {
    // Get buildings with issue counts
    const buildingStats = await db.select({
      buildingId: issues.buildingId,
      issueCount: count()
    })
    .from(issues)
    .groupBy(issues.buildingId)
    .orderBy(desc(count()))
    .limit(limit);
    
    // If no issues found, return empty array
    if (buildingStats.length === 0) {
      return [];
    }
    
    // Map of building IDs to gather for details
    const buildingIds = buildingStats.map(stat => stat.buildingId);
    
    // Handle empty buildingIds (shouldn't happen, but just in case)
    if (buildingIds.length === 0) {
      return [];
    }
    
    // Get building details
    const buildingDetails = await db.select()
      .from(buildings)
      .where(sql`${buildings.id} IN (${buildingIds.join(',')})`);
    
    // Create a map for quick lookup
    const buildingMap = new Map<number, Building>();
    buildingDetails.forEach(building => {
      buildingMap.set(building.id, building);
    });
    
    // Combine data
    return buildingStats
      .filter(stat => buildingMap.has(stat.buildingId)) // Make sure building exists
      .map(stat => {
        const building = buildingMap.get(stat.buildingId)!;
        const issueCount = stat.issueCount;
        
        // Determine status based on issue count
        let status = 'Low';
        if (issueCount > 30) status = 'Critical';
        else if (issueCount > 20) status = 'High';
        else if (issueCount > 10) status = 'Medium';
        
        // Mock trend (would use historical data in a real implementation)
        // Random value between -10 and 15 for demonstration
        const trend = Math.floor(Math.random() * 25) - 10;
        
        return {
          building,
          issueCount,
          status,
          trend
        };
      });
  }
  
  // Vector search implementation with robust fallback
  async searchIssues(query: string, limit = 10): Promise<Issue[]> {
    try {
      // Get all issues first
      const allIssues = await db.select().from(issues);
      
      // If we have no issues, return an empty array
      if (!allIssues || allIssues.length === 0) {
        console.log("No issues found in database for search");
        return [];
      }
      
      // Check if we have any issues with vectors
      const hasVectorData = allIssues.some(issue => issue.vector && issue.vector.length > 0);
      
      // If no vector data exists, use text search instead
      if (!hasVectorData) {
        console.log("No vector data found, using text search instead");
        return this.textBasedSearch(query, allIssues, limit);
      }
      
      // Generate embedding for the query
      const queryVector = await computeEmbedding(query);
      
      // PART 1: Search by issues directly
      const issuesWithScore = allIssues.map(issue => {
        if (!issue.vector) return { issue, score: 0 };
        
        // Calculate cosine similarity
        const similarity = this.cosineSimilarity(queryVector, issue.vector);
        return { issue, score: similarity };
      });
      
      // PART 2: Search by buildings and include their issues
      const allBuildings = await db.select().from(buildings);
      
      // Calculate building similarity scores
      const buildingSimilarityMap = new Map<number, number>();
      
      for (const building of allBuildings) {
        if (!building.vector) continue;
        
        // Calculate cosine similarity for the building
        const similarity = this.cosineSimilarity(queryVector, building.vector);
        
        // Store the similarity score for this building ID
        buildingSimilarityMap.set(building.id, similarity);
      }
      
      // Enhance issue scores with building relevance
      const enhancedIssuesWithScore = issuesWithScore.map(({ issue, score }) => {
        // If this issue's building has a high similarity, boost the score
        const buildingScore = buildingSimilarityMap.get(issue.buildingId) || 0;
        
        // Combine scores (70% issue score, 30% building score) for a balanced approach
        const combinedScore = score * 0.7 + buildingScore * 0.3;
        
        return { issue, score: combinedScore };
      });
      
      // Sort by combined similarity score and return top results
      return enhancedIssuesWithScore
        .sort((a, b) => b.score - a.score)
        .slice(0, limit)
        .map(result => result.issue);
    } catch (error) {
      console.error("Vector search failed:", error);
      
      // Fallback to text-based search
      const allIssues = await db.select().from(issues);
      return this.textBasedSearch(query, allIssues, limit);
    }
  }
  
  // Text-based search as a fallback for when vector search isn't available
  private textBasedSearch(query: string, allIssues: Issue[], limit: number): Issue[] {
    const queryLower = query.toLowerCase();
    const words = queryLower.split(/\s+/).filter(word => word.length > 2);
    
    // Score issues based on text matching
    const scoredIssues = allIssues.map(issue => {
      const descriptionLower = issue.description?.toLowerCase() || '';
      const categoryLower = issue.category.toLowerCase();
      
      // Calculate a simple relevance score
      let score = 0;
      
      // Check if description contains the exact query
      if (descriptionLower.includes(queryLower)) {
        score += 10;
      }
      
      // Check if description contains individual words from the query
      for (const word of words) {
        if (descriptionLower.includes(word)) {
          score += 2;
        }
      }
      
      // Check if category matches
      if (categoryLower.includes(queryLower)) {
        score += 5;
      }
      
      // Check if subIssues match
      for (const subIssue of issue.subIssues || []) {
        if (subIssue.toLowerCase().includes(queryLower)) {
          score += 3;
        }
      }
      
      return { issue, score };
    });
    
    // Sort by score and return top results
    return scoredIssues
      .filter(item => item.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, limit)
      .map(item => item.issue);
  }
  
  // Implementation for searching buildings by address using vector search with fallback
  async searchBuildingsByAddress(query: string, limit = 10): Promise<Building[]> {
    try {
      // Get all buildings
      const allBuildings = await db.select().from(buildings);
      
      // If we have no buildings, return an empty array
      if (!allBuildings || allBuildings.length === 0) {
        console.log("No buildings found in database for search");
        return [];
      }
      
      // Check if we have any buildings with vectors
      const hasVectorData = allBuildings.some(building => building.vector && building.vector.length > 0);
      
      // If no vector data exists, use text search instead
      if (!hasVectorData) {
        console.log("No building vector data found, using text search instead");
        return this.textBasedBuildingSearch(query, allBuildings, limit);
      }
      
      // Generate embedding for the address query
      const queryVector = await computeEmbedding(query);
      
      // Calculate similarity scores for each building
      const buildingsWithScore = allBuildings.map(building => {
        if (!building.vector) return { building, score: 0 };
        
        // Calculate cosine similarity
        const similarity = this.cosineSimilarity(queryVector, building.vector);
        return { building, score: similarity };
      });
      
      // Sort by similarity score and return top results
      return buildingsWithScore
        .sort((a, b) => b.score - a.score)
        .slice(0, limit)
        .map(result => result.building);
    } catch (error) {
      console.error("Vector search for buildings failed:", error);
      
      // Fallback to text-based search
      const allBuildings = await db.select().from(buildings);
      return this.textBasedBuildingSearch(query, allBuildings, limit);
    }
  }
  
  // Text-based search for buildings as a fallback
  private textBasedBuildingSearch(query: string, allBuildings: Building[], limit: number): Building[] {
    const queryLower = query.toLowerCase();
    const words = queryLower.split(/\s+/).filter(word => word.length > 2);
    
    // Score buildings based on text matching
    const scoredBuildings = allBuildings.map(building => {
      const addressLower = building.address?.toLowerCase() || '';
      const zipLower = building.zipCode?.toLowerCase() || '';
      const cityLower = building.city?.toLowerCase() || '';
      const stateLower = building.state?.toLowerCase() || '';
      
      // Calculate a simple relevance score
      let score = 0;
      
      // Check if address contains the exact query
      if (addressLower.includes(queryLower)) {
        score += 10;
      }
      
      // Check if zip code matches
      if (zipLower === queryLower) {
        score += 8;
      }
      
      // Check if city matches
      if (cityLower === queryLower) {
        score += 5;
      }
      
      // Check if state matches
      if (stateLower === queryLower) {
        score += 3;
      }
      
      // Check for individual words
      for (const word of words) {
        if (addressLower.includes(word)) {
          score += 2;
        }
      }
      
      return { building, score };
    });
    
    // Sort by score and return top results
    return scoredBuildings
      .filter(item => item.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, limit)
      .map(item => item.building);
  }
  
  // Implementation for searching issues by location information with error handling
  async searchIssuesByLocation(query: string, limit = 10): Promise<Issue[]> {
    try {
      // First, find relevant buildings that match the location query
      const relevantBuildings = await this.searchBuildingsByAddress(query, 100);
      
      // Get building IDs
      const buildingIds = relevantBuildings.map(building => building.id);
      
      // If no buildings match, return empty array
      if (buildingIds.length === 0) {
        console.log("No buildings match the location query:", query);
        return [];
      }
      
      // Get issues for these buildings
      const relevantIssues = await db.select()
        .from(issues)
        .where(sql`${issues.buildingId} IN (${buildingIds.join(',')})`);
      
      // If no issues found for these buildings, return empty array
      if (relevantIssues.length === 0) {
        console.log("No issues found for matching buildings");
        return [];
      }
      
      try {
        // Get the query vector
        const queryVector = await computeEmbedding(query);
        
        // Check if the issues have vector data
        const hasVectorData = relevantIssues.some(issue => issue.vector && issue.vector.length > 0);
        
        if (!hasVectorData) {
          // If no vector data, sort by date instead (most recent first)
          console.log("No vector data for issues, sorting by date instead");
          return relevantIssues
            .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
            .slice(0, limit);
        }
        
        // Calculate similarity scores for each issue
        const issuesWithScore = relevantIssues.map(issue => {
          if (!issue.vector) return { issue, score: 0 };
          
          // Calculate cosine similarity
          const similarity = this.cosineSimilarity(queryVector, issue.vector);
          return { issue, score: similarity };
        });
        
        // Sort by similarity score and return top results
        return issuesWithScore
          .sort((a, b) => b.score - a.score)
          .slice(0, limit)
          .map(result => result.issue);
      } catch (vectorError) {
        console.error("Vector similarity calculation failed:", vectorError);
        
        // Fallback to sorting by date if vector search fails
        return relevantIssues
          .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
          .slice(0, limit);
      }
    } catch (error) {
      console.error("Error in searchIssuesByLocation:", error);
      return [];
    }
  }
  
  // Helper method to calculate cosine similarity between two vectors
  private cosineSimilarity(vecA: number[], vecB: number[]): number {
    // Calculate dot product
    const dotProduct = vecA.reduce((sum, a, i) => sum + a * vecB[i], 0);
    
    // Calculate magnitudes
    const magnitudeA = Math.sqrt(vecA.reduce((sum, a) => sum + a * a, 0));
    const magnitudeB = Math.sqrt(vecB.reduce((sum, b) => sum + b * b, 0));
    
    // Return cosine similarity
    return dotProduct / (magnitudeA * magnitudeB);
  }
  
  // This is a placeholder implementation for the getIssueClusters method
  // It will be properly implemented later after the mockup is approved
  async getIssueClusters(
    addressFilter?: string,
    categoryFilter?: any,
    clusterCount: number = 5
  ): Promise<Array<{
    id: string;
    name: string;
    description: string;
    size: number;
    issues: any[];
  }>> {
    // We're using the mockup data for now, so this method is just a placeholder
    // It will be properly implemented later with actual clustering logic
    return [];
  }
}

// Use database storage instead of memory storage
export const storage = new DatabaseStorage();
